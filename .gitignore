# ------------------------------------------------------------------------------
# 방침 전환: 허용목록 -> 부정목록
#
# 이전 .gitignore는 `output/*` 를 통째로 무시하고 파일을 하나씩 `!` 로 되살리는
# 허용목록 방식이었다. 그래서 **새로 만든 산출물이 자동으로 무시되어** 커밋에서
# 조용히 빠졌다. 이제 output/ 은 기본 커밋 대상이고, 임시 산출물만 골라서 무시한다.
# ------------------------------------------------------------------------------

# --- 파이썬 ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- 가상환경 -------------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- 에디터 / OS ----------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- 모델 / 캐시 ----------------------------------------------------------
# Hugging Face 임베딩 모델은 저장소에 넣지 않는다 (수 GB). 실행 시 내려받는다.
.cache/
.huggingface/
huggingface/
hf_cache/
transformers_cache/
sentence_transformers_cache/
*.safetensors
*.bin.index.json
*.pt
*.ckpt

# --- 산출물 ---------------------------------------------------------------
# output/ 은 커밋한다 (재현 결과가 곧 논문 근거이므로).
# 다만 아래 임시 경로는 무시한다.
output/scratch/
output/tmp/
output/*.tmp
output/*.partial
output/.ipynb_checkpoints/

# --- 제3자 원본 자료 (재배포 대신 재취득) ---------------------------------
# data/SOURCES.md의 "제거 대상" 목록. `git rm --cached` 로 추적에서 뺀 뒤
# 로컬에 남아 있어도 다시 커밋되지 않도록 막는다.
# 재취득: `python fetch_sources.py fetch`
data/*.pdf
data/*.zip
data/*.html
# 원문 XML 캐시 (fetch_ecfr.py --save-xml)
data/raw/

# --- 로그 ---------------------------------------------------------------
*.log
nohup.out

# --- 커밋하지 않는 임시/외부 산출물 -----------------------------------------
# 33MB LLM 재순위 캐시: 재생성 가능하고 논문이 인용하지 않는다.
output/llm_rerank_cache.json
# 외부 에이전트(Hermes) 라운드의 v4 산출물. 코퍼스 v2 기준이 아니라 논문이 인용하지 않는다.
output/*_v4.json
output/fig_*_v4.png
output/report_v4.md
output/error_analysis.json
# 다른 에이전트에게 넘기려고 만든 임시 묶음
combined_for_codex.md
hermes_improvement_prompt.md
make_combined.py
